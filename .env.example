# MongoDB connection string. Leave empty to run against an in-memory MongoDB
# (auto-seeded with demo data, reset on every restart).
MONGO_URI=mongodb://127.0.0.1:27017/tutorhub
# Used when the URI has no database name (e.g. a bare Atlas cluster URL)
# MONGO_DB_NAME=tutorhub
# Seed demo data automatically when the database is empty (set to false in production)
# SEED_ON_EMPTY=true

# Secret for signing login tokens – use a long random value in production
JWT_SECRET=change-me-in-production

# Public URL of this site – used for canonical URLs, sitemap.xml and Open Graph tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000
